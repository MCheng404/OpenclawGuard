<Page x:Class="OpenclawGuard.Pages.GatewayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" Margin="32">
        <TextBlock Text="Gateway" Style="{ThemeResource TitleTextBlockStyle}"/>
        <TextBlock Text="Start / Stop / Restart Openclaw Gateway"/>
        <Button Content="Start" Width="120" HorizontalAlignment="Left"/>
        <Button Content="Stop" Width="120" HorizontalAlignment="Left"/>
        <Button Content="Restart" Width="120" HorizontalAlignment="Left"/>
    </StackPanel>
</Page>
