<Page x:Class="OpenclawGuard.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" Margin="32">
        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}"/>
        <TextBlock Text="App preferences"/>
        <ComboBox Header="Theme:" Width="200" HorizontalAlignment="Left" SelectedIndex="0">
            <ComboBoxItem>Dark</ComboBoxItem>
            <ComboBoxItem>Light</ComboBoxItem>
            <ComboBoxItem>System</ComboBoxItem>
        </ComboBox>
    </StackPanel>
</Page>
